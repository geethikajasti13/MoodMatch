# ---- MoodMatch Frontend Environment ----
# Copy this file to ".env" (in the project root) if you want to override defaults.

# URL of the Express + MongoDB backend.
# If the backend is not running, the app automatically falls back to its
# bundled dataset so everything still works for demos and grading.
VITE_API_URL=http://localhost:5000/api

# Set to "false" to disable the local-data fallback (require the backend).
VITE_ALLOW_FALLBACK=true
