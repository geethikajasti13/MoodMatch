
# MoodMatch Backend Environment Variables Template
# Copy this file to .env and add your own configuration.
# Never commit real credentials to GitHub.

PORT=5000
CLIENT_URL=http://localhost:5173

# Local MongoDB example:
# MONGODB_URI=mongodb://localhost:27017/moodmatch

# MongoDB Atlas example:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/moodmatch?retryWrites=true&w=majority
