# ==============================================================================
# MoodMatch — Vercel & Production Environment Variables Template
# ==============================================================================
# In Vercel Project Settings -> Environment Variables, add:
#
# 1. MONGODB_URI (Required)
#    Your MongoDB Atlas connection string.
#    Example: mongodb+srv://<username>:<password>@cluster0.jqz70yc.mongodb.net/moodmatch?retryWrites=true&w=majority
#
#    IMPORTANT for MongoDB Atlas:
#    - In Atlas Dashboard -> Network Access, add IP Address: 0.0.0.0/0 (Allow from Anywhere)
#      so Vercel's dynamic serverless functions can connect.
#    - In Atlas Dashboard -> Database Access, ensure your user has read/write privileges.
#
# 2. CLIENT_URL (Optional)
#    Your Vercel deployment URL or custom domain (e.g., https://your-project.vercel.app).
#    Defaults to permissive CORS for same-domain API access.
#
# 3. VITE_API_URL (Optional)
#    Only needed if hosting frontend and backend on separate domains.
#    When deployed together on Vercel, leave empty to automatically use same-domain /api.
# ==============================================================================

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/moodmatch?retryWrites=true&w=majority
CLIENT_URL=https://your-project.vercel.app
